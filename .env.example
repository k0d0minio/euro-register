# Names only. Put the values in .env (gitignored). Never commit a value.

# Neon Postgres connection string (pooled).
DATABASE_URL=

# Public base URL of the app, used in the sign-in links. Dev default: http://localhost:3000
APP_URL=

# Comma-separated admin emails. An admin reads every report, drafts too.
ADMIN_EMAILS=

# Employee sign-in emails: comma-separated slug=email pairs. Only here, never in git or the DB.
# `pnpm seed <folder> --print-env` prints this line from the report files.
EMPLOYEE_EMAILS=

# Resend. In development the app logs the link and sends no mail.
RESEND_API_KEY=
MAIL_FROM=
